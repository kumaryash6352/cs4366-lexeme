{
  "image": "localhost/lexeme-analysis:dev",
  "localDevelopment": true,
  "container": {
    "memory": "512m",
    "pidsLimit": 128
  },
  "timeouts": {
    "analysisMs": 60000,
    "imagePullMs": 300000,
    "packageCommandMs": 300000
  },
  "limits": {
    "projectFiles": 1000,
    "projectBytes": 10485760,
    "projectDepth": 32,
    "sourceBytes": 10485760,
    "includeDirs": 128,
    "defines": 256,
    "maxRequestedDependencies": 128,
    "workerLogBytes": 10485760,
    "errorTailBytes": 4096,
    "artifactBytes": 33554432
  }
}
